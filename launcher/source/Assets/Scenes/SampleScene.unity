      objectReference: {fileID: 0}
    - target: {fileID: 790480876947444150, guid: d0f51024171f5ba4a962085d5c5a81d4, type: 3}
      propertyPath: description
      value: 'Bubble Dream is a game made for the 2025 Global Game Jam under the
        theme "bubbles." It is a Lemmings-inspired puzzle game about guiding a dreaming
        girl to her stuffed animals. The player must experiment with their inputs
        to see what that can control and in what way, and they have infinite tries
        to get the girl to the goal. There are a total of 10 playable levels. Completed
        on January 26th 2025. '
      objectReference: {fileID: 0}
