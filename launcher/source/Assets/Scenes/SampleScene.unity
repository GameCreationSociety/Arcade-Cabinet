      propertyPath: controls
      value: 'Joystick - Move

        1 - Select

        4 - Undo

        5 -
        Retry

        Pause - Quit Stage'
      objectReference: {fileID: 0}
    - target: {fileID: 790480876947444150, guid: d0f51024171f5ba4a962085d5c5a81d4, type: 3}
      propertyPath: gameName
      value: NumbeRoads
      objectReference: {fileID: 0}
    - target: {fileID: 790480876947444150, guid: d0f51024171f5ba4a962085d5c5a81d4, type: 3}
      propertyPath: description
      value: "You\u2019ve been called in to build Roads. Roads to connect to unfamiliar
        places. Places with rules. And Numbers.\r\n\r\nNumbeRoads is a grid-based
        puzzle game where you must traverse stages to build Roads while sticking
        to the given rules. Each stage has a unique shape, numbers, and colors, which
        govern where you can build your Road. Advance through a variety of stages
        to help expand the Road network."
      objectReference: {fileID: 0}
    - target: {fileID: 790480876947444150, guid: d0f51024171f5ba4a962085d5c5a81d4, type: 3}
      propertyPath: gameProfile
