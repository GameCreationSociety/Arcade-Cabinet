    - target: {fileID: 790480876947444150, guid: d0f51024171f5ba4a962085d5c5a81d4, type: 3}
      propertyPath: credits
      value: "Fruit Fight\t\t\t- Alyssa Lee - Programming/Art\r\nBombastic\t\t- Scott
        King, Nathan Oswell, Nicholas Hungria - Programming\r\n\t\t\t\t- Anqi Chen
        - Art\r\r\nPinball Pong\t\t- Jonathan Fischer - Programming\r\nStarFall\t\t\t-
        Angie Bonilla - Art\n\t\t\t\t- George Armentrout - Programming\n\t\t\t\t-
        Alana Gerald - Programming/Art"
      objectReference: {fileID: 0}
    - target: {fileID: 790480876947444150, guid: d0f51024171f5ba4a962085d5c5a81d4, type: 3}
      propertyPath: gameName
      value: Game Bytes F2020
      objectReference: {fileID: 0}
    - target: {fileID: 790480876947444150, guid: d0f51024171f5ba4a962085d5c5a81d4, type: 3}
      propertyPath: description
      value: 'Game Bytes 2020 features 4 minigames:

        Fruit Fight: Use your
        long tongue to grab as many fruits as possible!

        Bombastic: Stick
        the other player with the bomb before the timer runs out!

        Pinball
        Pong: Pong and pinball collide! Don''t let the ball drop on your end of the
        field! You can use your paddle''s flippers to make the ball bounce at all
        sorts of funky angles.

        StarFall: In StarFall, you can be a friendly
        robot or a mischievous alien. Collect as many stars as you can before time
        runs out to win!'
      objectReference: {fileID: 0}
    - target: {fileID: 790480876947444150, guid: d0f51024171f5ba4a962085d5c5a81d4, type: 3}
      propertyPath: gameProfile
